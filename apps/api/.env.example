DATABASE_URL=postgresql+psycopg://jojobuilds:CHANGE_ME@127.0.0.1:5432/jojobuilds
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DATA_DIR=./data
SESSION_HOURS=12
# Production requires secure cookies and HTTPS.
# Local SMTP is optional; undelivered messages remain in the database outbox.
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=JOJOBUILDS <noreply@localhost>
# Optional server-only credentials; leave both empty for password sign-in.
# Register WEB_ORIGIN/api/v1/auth/google/callback as the Google redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
